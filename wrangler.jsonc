// Despliegue en Cloudflare (Workers con assets estáticos): npm run build && npx wrangler deploy
{
  "name": "fernando-montelongo",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Dominio propio: Cloudflare crea los registros DNS y el certificado.
  "routes": [
    { "pattern": "fer-m.dev", "custom_domain": true },
    { "pattern": "www.fer-m.dev", "custom_domain": true }
  ]
}
